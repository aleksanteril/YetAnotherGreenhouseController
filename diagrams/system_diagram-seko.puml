@startuml
!theme reddress-lightgreen

title CO2 Controller - FreeRTOS System Diagram

top to bottom direction

skinparam shadowing false
skinparam nodesep 42
skinparam ranksep 65
skinparam defaultTextAlignment left
skinparam ArrowThickness 1
skinparam RectangleRoundCorner 8

skinparam rectangle {
    BorderColor #666666
    FontColor #222222
    BackgroundColor #EDEDED

    BackgroundColor<<task>> #DCEBFA
    BackgroundColor<<hw>> #DFF3E3
    BackgroundColor<<service>> #E7EFEF
    BackgroundColor<<timer>> #FFE0B2
    BackgroundColor<<isr>> #F8DDDD
    BackgroundColor<<sync>> #ECE4F7
}

skinparam queue {
    BorderColor #666666
    FontColor #222222
    BackgroundColor #FFF6CC
}

skinparam package {
    BorderColor #888888
    FontColor #222222
    BackgroundColor #FFFFFF
}

skinparam legend {
    BackgroundColor #FFFFFF
    BorderColor #666666
    FontColor #222222
}

' ============================================================
' FreeRTOS timers
' ============================================================

package "FreeRTOS Timers" as TIMERS {
    rectangle "UI Inactivity Timer\n\n- FreeRTOS software timer\n- 15 s one-shot" as UI_TIMER <<timer>>
    rectangle "CO2 Valve Timer\n\n- FreeRTOS software timer\n- 30 s periodic" as VALVE_TIMER <<timer>>

    UI_TIMER -[hidden]right-> VALVE_TIMER
}

' ============================================================
' ISRs
' ============================================================

package "ISRs" as ISRS {
    rectangle "Rotary Encoder ISR" as ROT_ISR <<isr>>
    rectangle "Valve Alarm ISR" as VALVE_ISR <<isr>>

    ROT_ISR -[hidden]right-> VALVE_ISR
}

' ============================================================
' FreeRTOS IPC / Synchronization
' final left-to-right order chosen for cleaner later routing
' ============================================================

package "FreeRTOS IPC / Synchronization" as IPC {
    queue "network_mb\nqueue length 1" as NETWORK_MB
    queue "setpoint_mb\nqueue length 1" as SETPOINT_MB
    rectangle "Button event group\npause / resume button polling" as BUTTON_EG <<sync>>
    queue "DisplayEvent_q\nFreeRTOS queue" as DISPLAY_Q
    rectangle "EEPROM event group\nread / write synchronization" as EEPROM_EG <<sync>>
    queue "Sensor mailboxes\n\ntemp_mb, rh_mb, co2_mb\nqueue length 1 each" as SENSOR_MB

    NETWORK_MB -[hidden]left-> SETPOINT_MB
    SETPOINT_MB -[hidden]left-> BUTTON_EG
    BUTTON_EG -[hidden]left-> DISPLAY_Q
    DISPLAY_Q -[hidden]left-> EEPROM_EG
    EEPROM_EG -[hidden]left-> SENSOR_MB
}

' ============================================================
' Application Tasks
' final left-to-right order chosen for cleaner later routing
' ============================================================

package "Application Tasks" as TASKS {
    rectangle "Network Task\n\n- Wi-Fi / ThingSpeak\n- sends measurements" as NETWORK_TASK <<task>>
    rectangle "Controller Task\n\n- PID / control logic\n- controls fan and valve timing" as CTRL_TASK <<task>>
    rectangle "Button Tasks (2)\n\n- SW0 and SW2\n- poll push buttons\n- send UI events" as BUTTON_TASKS <<task>>
    rectangle "UI Task\n\n- handles display state\n- updates display" as UI_TASK <<task>>
    rectangle "Temp / RH Task\n\n- reads temperature / humidity\n- publishes sensor values" as TEMP_TASK <<task>>
    rectangle "Shell Task\n\n- UART command interface\n- reads / changes settings" as SHELL_TASK <<task>>

    CTRL_TASK -[hidden]right-> UI_TASK
    UI_TASK -[hidden]right-> BUTTON_TASKS
    BUTTON_TASKS -[hidden]right-> SHELL_TASK
    SHELL_TASK -[hidden]right-> TEMP_TASK
    TEMP_TASK -[hidden]right-> NETWORK_TASK
}

' ============================================================
' Services / Hardware
' ============================================================

package "Services / Hardware" as HW {
    rectangle "Fan Controller\nModbus" as FAN <<hw>>
    rectangle "CO2 Sensor\nModbus" as CO2_SENSOR <<hw>>
    rectangle "Temp / RH Sensor\nModbus" as TEMP_SENSOR <<hw>>
    rectangle "CO2 Valve\nGPIO" as VALVE <<hw>>
    rectangle "EEPROM\nI2C0" as EEPROM <<service>>
    rectangle "UART0" as UART <<service>>

    FAN -[hidden]right-> CO2_SENSOR
    CO2_SENSOR -[hidden]right-> TEMP_SENSOR
    TEMP_SENSOR -[hidden]right-> VALVE
    VALVE -[hidden]right-> EEPROM
    EEPROM -[hidden]right-> UART
}

' ============================================================
' package-level layout
'
' broad layer structure only
' timer / isr placement is controlled by stronger node anchors
' below so visible arrows do not have to position those packages
' ============================================================

TIMERS -[hidden]right-> IPC
IPC -[hidden]down-> TASKS
TASKS -[hidden]down-> HW

' ============================================================
' stronger timer / isr placement anchors
'
' these replace the need for visible timer / isr arrows
' to control the overall package layout
' ============================================================

' timers stay immediately to the left of their related ipc area
UI_TIMER -[hidden]right-> NETWORK_MB
VALVE_TIMER -[hidden]right-> SETPOINT_MB

' isrs stay directly below the timer package
UI_TIMER -[hidden]down-> ROT_ISR
VALVE_TIMER -[hidden]down-> VALVE_ISR

' isr package stays to the left of the application layer
ROT_ISR -[hidden]right-> NETWORK_TASK
VALVE_ISR -[hidden]right-> CTRL_TASK

' keep rotary isr positioned relative to DisplayEvent_q
' ROT_ISR -[hidden]-> DISPLAY_Q

' ============================================================
' vertical alignment anchors
'
' these are the main column guides for the final diagram
' ============================================================

NETWORK_MB -[hidden]down-> NETWORK_TASK
SETPOINT_MB -[hidden]down-> CTRL_TASK
BUTTON_EG -[hidden]down-> BUTTON_TASKS
DISPLAY_Q -[hidden]down-> UI_TASK
SENSOR_MB -[hidden]down-> TEMP_TASK
EEPROM_EG -[hidden]down-> SHELL_TASK

' ============================================================
' task / hardware alignment anchors
' ============================================================

CTRL_TASK -[hidden]down-> CO2_SENSOR
TEMP_TASK -[hidden]down-> TEMP_SENSOR
UI_TASK -[hidden]down-> EEPROM
SHELL_TASK -[hidden]down-> UART

' ============================================================
' VISIBLE ARROWS
' uncomment ONE LINE at a time, in the numbered order below
' ============================================================

' --- 01
SHELL_TASK <--> UART : commands / output

' --- 02
SHELL_TASK <--> EEPROM : read / write

' --- 03
UI_TASK <--> EEPROM : read / write

' --- 04
TEMP_SENSOR --> TEMP_TASK : read

' --- 05
CO2_SENSOR --> CTRL_TASK : read

' --- 06
CTRL_TASK --> FAN : control

' --- 07
CTRL_TASK -[dashed,norank]up-> VALVE_TIMER : start / stop

' --- 08
VALVE_TIMER --> VALVE : open

' --- 09
VALVE_TIMER --> VALVE_ISR : HW alarm

' --- 10
VALVE_ISR --> VALVE : close

' --- 11
UI_TASK -[dashed,norank]left-> UI_TIMER : reset

' --- 12
' UI_TIMER ..> DISPLAY_Q : INACTIVE

' --- 13
ROT_ISR -[dashed,norank]right-> DISPLAY_Q : FromISR

' --- 14
NETWORK_MB ..down.> NETWORK_TASK : read

' --- 15
SETPOINT_MB ..down.> CTRL_TASK : read

' --- 16
BUTTON_EG ..down.> BUTTON_TASKS : wait

' --- 17
DISPLAY_Q ..down.> UI_TASK : receive

' --- 18
TEMP_TASK ..up.> SENSOR_MB : temp / rh

' --- 19
CTRL_TASK -[dashed,norank]right-> SENSOR_MB : CO2

' --- 20
SENSOR_MB ..> UI_TASK : read

' --- 21
SENSOR_MB ..> NETWORK_TASK : read

' --- 22
BUTTON_TASKS -[dashed,norank]left-> DISPLAY_Q : event

' --- 23
UI_TASK -[dashed,norank]up-> BUTTON_EG : set / clear

' --- 24
SETPOINT_MB ..> UI_TASK : read

' --- 25
' SETPOINT_MB ..> NETWORK_TASK : read

' --- 26
' TEMP_TASK ..> DISPLAY_Q : UPDATE

' --- 27
' CTRL_TASK ..> DISPLAY_Q : UPDATE

' --- 28
' EEPROM ..> NETWORK_MB : update

' --- 29
' EEPROM ..> SETPOINT_MB : update

' --- 30
' EEPROM ..> EEPROM_EG : sync

' ============================================================
' legend
' ============================================================

legend bottom right
  <back:#DCEBFA>   </back> task
  <back:#DFF3E3>   </back> hardware
  <back:#E7EFEF>   </back> service
  <back:#FFF6CC>   </back> FreeRTOS IPC
  <back:#FFE0B2>   </back> FreeRTOS timer
  <back:#F8DDDD>   </back> ISR
  <back:#ECE4F7>   </back> sync / event group

  <--> bidirectional service access
  -->  direct hardware / service access
  ..>  FreeRTOS kernel mechanism

  7 task instances total
  (Button Tasks = 2 instances)
endlegend

@enduml